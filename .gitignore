node_modules
dist
dist-ssr
*.local
.DS_Store
.vite

# Кэш заголовочного шрифта для OG-скрипта. Лежит вне node_modules намеренно:
# `npm ci` сносит node_modules целиком, и кэш внутри него не пережил бы установку.
# Сам шрифт (M PLUS Rounded 1c) — OFL, коммитить его можно, но полный TTF семейства
# весит мегабайты, а нужен сабсет: проще держать в кэше. Разбор — assets/fonts/README.md.
.cache

# Локальные настройки инструментов и черновые снимки экрана
.claude/settings.local.json
.shots/

# OG-карточка и apple-touch-icon генерируются сборкой
# (scripts/generate-og.mjs, scripts/generate-icons.mjs).
# В репозитории держим исходник (favicon.svg), а не производный растр.
public/og.png
public/apple-touch-icon.png
public/favicon.ico

# Исходный медиа-архив (оригиналы от владельца). В прод едут только
# оптимизированные производные из public/media — см. scripts/optimize-media.mjs.
site media/

# Исходные TTF-киты от владельца (~17 МБ). Сайт их не использует: присланные
# M PLUS 1 и Assistant не содержат кириллицы вообще — 0 кодпоинтов в U+0400–U+04FF,
# замерено разбором cmap, — поэтому взяты M PLUS Rounded 1c и IBM Plex Sans.
# Рабочие шрифты сайта лежат в public/fonts и в git ЕСТЬ.
# Слеш в начале обязателен: без него шаблон матчит любой каталог `fonts`
# на любой глубине — то есть заодно public/fonts и assets/fonts, и шрифты
# сайта молча не попали бы в коммит. Проверено `git check-ignore -v`.
/fonts/
